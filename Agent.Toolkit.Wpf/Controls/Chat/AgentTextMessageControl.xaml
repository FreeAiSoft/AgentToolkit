<UserControl x:Class="Agent.Toolkit.Wpf.Controls.Chat.AgentTextMessageControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chat="clr-namespace:Agent.Toolkit.Wpf.Controls.Chat">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Agent.Toolkit.Wpf;component/Styles/ChatResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <chat:ChatMessageCard>
        <StackPanel>
            <Expander x:Name="ReasoningExpander" Header="{Binding ReasoningHeader, Mode=OneWay}" IsExpanded="{Binding IsThinking, Mode=OneWay}"
                      Foreground="{DynamicResource Theme.Text}"
                      Visibility="{Binding ShowReasoning, Converter={StaticResource BoolToVis}}">
                <ScrollViewer MaxHeight="200"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="{DynamicResource Theme.CodeBackground}">
                    <TextBox Text="{Binding ReasoningDisplayText, Mode=OneWay}"
                             Foreground="{DynamicResource Theme.TextMuted}" FontStyle="Italic"
                             IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="TextWrapping" Value="Wrap"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsThinking}" Value="True">
                                        <Setter Property="TextWrapping" Value="NoWrap"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                </ScrollViewer>
            </Expander>
            <ItemsControl x:Name="AnswerList" ItemsSource="{Binding Blocks, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                                <DataTemplate>
                        <ContentControl Content="{Binding}"/>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </chat:ChatMessageCard>
</UserControl>
