<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone WPF host used to smoke-test the shared chat UI (Agent.Toolkit.Wpf.ChatControl)
    without a VSIX/studio host. Targets net472 to match Agent.Toolkit.Wpf and just wires the
    control to an in-memory chat model and a stub IChatHost.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>Agent.ChatHost</RootNamespace>
    <AssemblyName>Agent.ChatHost</AssemblyName>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Installs the WPF geometry parser that MaterialIconDataProvider.Get<Geometry> needs;
         without it every toolkit icon resolves to Geometry.Empty and renders invisible. -->
    <PackageReference Include="Material.Icons.WPF" Version="3.0.2" />
    <!-- Host-side logging implementation for the toolkit's IAgentLogger seam. -->
    <PackageReference Include="NLog" Version="5.3.4" />
    <None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" />

  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent.Core\Agent.Core.csproj" />
    <ProjectReference Include="..\Agent.Models\Agent.Models.csproj" />
    <ProjectReference Include="..\Agent.Mvvm\Agent.Mvvm.csproj" />
    <ProjectReference Include="..\Agent.Toolkit.Wpf\Agent.Toolkit.Wpf.csproj" />
  </ItemGroup>

</Project>
