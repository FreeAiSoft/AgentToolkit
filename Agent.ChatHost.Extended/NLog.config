<?xml version="1.0" encoding="utf-8" ?>
<nlog xmlns="http://www.nlog-project.org/schemas/NLog.xsd"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      autoReload="true"
      throwExceptions="false"
      internalLogLevel="Off">

  <!-- ${var:logdir} is set at startup by LoggingBootstrap.Configure() to <repo-root>/logs
       (or %LocalAppData%\AgentChatHost.Extended\logs as a fallback). -->
  <variable name="logdir" value="logs" />

  <targets>
    <!-- Single shared log file; rolling archive keeps the last few 10MB chunks. -->
    <target xsi:type="File"
            name="file"
            fileName="${var:logdir}/agent-chat-host-extended.log"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}"
            archiveAboveSize="10485760"
            maxArchiveFiles="5"
            archiveFileName="${var:logdir}/agent-chat-host-extended.{#}.log"
            archiveNumbering="Rolling" />

    <!-- Mirrors the same lines to the Visual Studio Output window (Debug) for convenience. -->
    <target xsi:type="Debugger"
            name="debugger"
            layout="${longdate}|${level:uppercase=true}|${logger}|${message}${onexception:inner= ${exception:format=tostring}}" />
  </targets>

  <rules>
    <!-- Capture everything from every logger (the IAgentLogger adapter uses the
         "Agent.ChatHost.Extended" logger; WpfLog arrives through NLogTraceListener). -->
    <logger name="*" minlevel="Trace" writeTo="file" />
    <logger name="*" minlevel="Trace" writeTo="debugger" />
  </rules>
</nlog>
