<UserControl x:Class="Agent.Toolkit.Wpf.Controls.MessageQueueControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:Agent.Toolkit.Wpf.Converters"
             xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Agent.Toolkit.Wpf;component/Styles/ChatResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- Theme brushes come from the Dark/Light palette registered by AgentThemeManager. -->
            <conv:MaterialIconToGeometryConverter x:Key="MaterialIconToGeometry"/>
            <conv:PendingDeliveryToGeometryConverter x:Key="PendingDeliveryToGeometry"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- Visibility is managed from code-behind (UpdateVisibility). -->
    <Border Background="{DynamicResource Theme.Panel}" BorderBrush="{DynamicResource Theme.Border}"
            BorderThickness="1" CornerRadius="2" Padding="8,6">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>   <!-- header -->
                <RowDefinition Height="Auto"/>   <!-- list -->
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="QueuedLabel" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource Theme.Text}"/>
                <Button Grid.Column="1" Width="22" Height="22" Click="OnClearAll"
                        Style="{StaticResource IconButtonStyle}" ToolTip="Clear all">
                    <Path Data="{Binding Source={x:Static mi:MaterialIconKind.Broom}, Converter={StaticResource MaterialIconToGeometry}}"
                          Fill="{DynamicResource Theme.Text}" Stretch="Uniform" Width="14" Height="14"/>
                </Button>
            </Grid>

            <!-- List -->
            <ItemsControl Grid.Row="1" x:Name="QueueList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/> <!-- steer toggle -->
                                <ColumnDefinition Width="*"/>    <!-- editable text -->
                                <ColumnDefinition Width="Auto"/> <!-- attachments -->
                                <ColumnDefinition Width="Auto"/> <!-- up -->
                                <ColumnDefinition Width="Auto"/> <!-- down -->
                                <ColumnDefinition Width="Auto"/> <!-- delete -->
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" ToolTip="{Binding DeliveryToolTip}"
                                    Style="{StaticResource IconButtonStyle}" Width="22" Height="22"
                                    Margin="0,0,4,0" Click="OnSteer" IsEnabled="{Binding CanSteer}">
                                <Grid>
                                    <Path Data="{Binding Delivery, Converter={StaticResource PendingDeliveryToGeometry}}"
                                          Fill="{DynamicResource Theme.Text}" Stretch="Uniform" Width="12" Height="12"/>
                                    <Path Data="{Binding Delivery, Converter={StaticResource PendingDeliveryToGeometry}}"
                                          Stretch="Uniform" Width="12" Height="12">
                                        <Path.Fill>
                                            <LinearGradientBrush MappingMode="RelativeToBoundingBox" SpreadMethod="Repeat"
                                                                 StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Color="{DynamicResource Theme.SteerShimmerLow}" Offset="0"/>
                                                <GradientStop Color="{DynamicResource Theme.SteerShimmerHigh}" Offset="0.5"/>
                                                <GradientStop Color="{DynamicResource Theme.SteerShimmerLow}" Offset="1"/>
                                            </LinearGradientBrush>
                                        </Path.Fill>
                                        <Path.Style>
                                            <Style TargetType="Path">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSteered}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                        <DataTrigger.EnterActions>
                                                            <BeginStoryboard Name="SteerShimmer">
                                                                <Storyboard RepeatBehavior="Forever">
                                                                    <PointAnimation Storyboard.TargetProperty="Fill.(LinearGradientBrush.StartPoint)"
                                                                                    From="0,0" To="1,0" Duration="0:0:1.2"/>
                                                                    <PointAnimation Storyboard.TargetProperty="Fill.(LinearGradientBrush.EndPoint)"
                                                                                    From="1,0" To="2,0" Duration="0:0:1.2"/>
                                                                </Storyboard>
                                                            </BeginStoryboard>
                                                        </DataTrigger.EnterActions>
                                                        <DataTrigger.ExitActions>
                                                            <StopStoryboard BeginStoryboardName="SteerShimmer"/>
                                                        </DataTrigger.ExitActions>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Path.Style>
                                    </Path>
                                </Grid>
                            </Button>

                            <TextBox Grid.Column="1" Text="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                     Background="Transparent" BorderThickness="0" Padding="0"
                                     VerticalAlignment="Center" TextWrapping="NoWrap"
                                     Foreground="{DynamicResource Theme.Text}" CaretBrush="{DynamicResource Theme.Text}"/>

                            <TextBlock Grid.Column="2" Text="{Binding AttachmentSummary, Mode=OneWay}"
                                       VerticalAlignment="Center" Margin="6,0,4,0"
                                       Foreground="{DynamicResource Theme.Text}"
                                       Visibility="{Binding HasAttachments, Converter={StaticResource BoolToVis}}"/>

                            <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}"
                                    Width="22" Height="22" Margin="0,0,2,0" Click="OnMoveUp" ToolTip="Move up">
                                <Path Data="{Binding Source={x:Static mi:MaterialIconKind.ChevronUp}, Converter={StaticResource MaterialIconToGeometry}}"
                                      Fill="{DynamicResource Theme.Text}" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                            <Button Grid.Column="4" Style="{StaticResource IconButtonStyle}"
                                    Width="22" Height="22" Margin="0,0,2,0" Click="OnMoveDown" ToolTip="Move down">
                                <Path Data="{Binding Source={x:Static mi:MaterialIconKind.ChevronDown}, Converter={StaticResource MaterialIconToGeometry}}"
                                      Fill="{DynamicResource Theme.Text}" Stretch="Uniform" Width="12" Height="12"/>
                            </Button>
                            <Button Grid.Column="5" Style="{StaticResource IconButtonStyle}"
                                    Width="22" Height="22" Click="OnDelete" ToolTip="Remove from queue">
                                <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource Theme.Text}"/>
                            </Button>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>
    </Border>
</UserControl>
