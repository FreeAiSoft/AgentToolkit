<UserControl x:Class="Agent.Toolkit.Wpf.Controls.ChatControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:toolkit="clr-namespace:Agent.Toolkit.Wpf.Controls"
             xmlns:corem="clr-namespace:Agent.Core.Models;assembly=Agent.Core"
             xmlns:mi="clr-namespace:Material.Icons;assembly=Material.Icons">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Agent.Toolkit.Wpf;component/Styles/AgentTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
            <Grid x:Name="ChatRoot">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="3*" MinHeight="60"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="1*" MinHeight="80"/>
                </Grid.RowDefinitions>

                <StackPanel x:Name="ChatToolbarPanel" Grid.Row="0" Margin="0,0,0,0">
                    <ContentControl x:Name="VoiceErrorToastSlot" Margin="0,0,0,6" Visibility="Collapsed"/>
                    <WrapPanel Margin="0,5,0,5">
                        <Button Width="26" Height="26" Margin="0,0,4,4" Click="OnNewChat"
                                Style="{StaticResource ChatInputActionButtonStyle}" ToolTip="New chat">
                            <Path Data="{Binding Source={x:Static mi:MaterialIconKind.Plus}, Converter={StaticResource MaterialIconToGeometry}}"
                                  Fill="{DynamicResource Theme.Text}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Button Width="26" Height="26" Margin="0,0,4,4" Click="OnShowHistory"
                                Style="{StaticResource ChatInputActionButtonStyle}" ToolTip="Browse saved chats (keeps the current chat active)">
                            <Path Data="{Binding Source={x:Static mi:MaterialIconKind.TimelineTextOutline}, Converter={StaticResource MaterialIconToGeometry}}"
                                  Fill="{DynamicResource Theme.Text}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Button Width="26" Height="26" Margin="0,0,4,4" Click="OnCommit"
                                Style="{StaticResource ChatInputActionButtonStyle}" ToolTip="Commit">
                            <Path Data="{Binding Source={x:Static mi:MaterialIconKind.SourceCommit}, Converter={StaticResource MaterialIconToGeometry}}"
                                  Fill="{DynamicResource Theme.Text}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Button Width="26" Height="26" Margin="0,0,4,4" Click="OnSendErrors"
                                Style="{StaticResource ChatInputActionButtonStyle}" ToolTip="Send errors to chat">
                            <Path Data="{Binding Source={x:Static mi:MaterialIconKind.AlertCircleOutline}, Converter={StaticResource MaterialIconToGeometry}}"
                                  Fill="{DynamicResource Theme.Text}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                        <Button Width="26" Height="26" Margin="0,0,4,4" Click="OnCopyConversation"
                                Style="{StaticResource ChatInputActionButtonStyle}" ToolTip="Copy all chat messages">
                            <Path Data="{Binding Source={x:Static mi:MaterialIconKind.ContentCopy}, Converter={StaticResource MaterialIconToGeometry}}"
                                  Fill="{DynamicResource Theme.Text}" Width="15" Height="15" Stretch="Uniform"/>
                        </Button>
                    </WrapPanel>
                    <ContentControl x:Name="OptionsWarningToastSlot" Margin="0,0,0,6" Visibility="Collapsed"/>
                    <ContentControl x:Name="CommitResultBarSlot" Margin="0,0,0,6" Visibility="Collapsed"/>
                    <ContentControl x:Name="CheckpointRestoreErrorToastSlot" Margin="0,0,0,6" Visibility="Collapsed"/>
                    <ContentControl x:Name="CreateRobotPanelSlot" Margin="0,0,0,6" Visibility="Collapsed"/>
                </StackPanel>

                <ContentControl x:Name="CommitEditorSlot" Grid.Row="1" Margin="0,0,0,6" Visibility="Collapsed"/>

                <Grid x:Name="MessagesHostPanel" Grid.Row="2" Margin="0,0,0,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="PinnedHeaderPanel" Grid.Row="0" Margin="0,0,0,4"
                            Background="#1A64B5F6"
                            BorderThickness="0" CornerRadius="2" Padding="8,6"
                            Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0" Style="{StaticResource IconButtonStyle}" Width="20" Height="20"
                                        VerticalAlignment="Top" Click="OnPinnedExpandToggle"
                                        ToolTip="Expand/collapse message">
                                    <Viewbox Width="16" Height="16">
                                        <Polyline x:Name="PinnedExpandGlyph"
                                                  Points="9,18 15,12 9,6"
                                                  Stroke="{DynamicResource Theme.Text}"
                                                  StrokeThickness="2"
                                                  StrokeLineJoin="Round"
                                                  StrokeStartLineCap="Round"
                                                  StrokeEndLineCap="Round"
                                                  Fill="Transparent"/>
                                    </Viewbox>
                                </Button>
                                <TextBlock x:Name="PinnedSummaryText" Grid.Column="1" Margin="8,0,8,0"
                                           VerticalAlignment="Center" TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           Text="{Binding SingleLineDisplayText, Mode=OneWay}"/>
                                <ScrollViewer x:Name="PinnedTextScroll" Grid.Column="1" Margin="8,0,8,0"
                                              VerticalAlignment="Top" MaxHeight="240"
                                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                              Visibility="Collapsed">
                                    <ItemsControl ItemsSource="{Binding Blocks, Mode=OneWay}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <ContentControl Content="{Binding}"/>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                        VerticalAlignment="Top" Margin="0,0,10,0"
                                        ToolTip="Copy message" Click="OnCopyPinnedMessage">
                                    <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                          Fill="{DynamicResource Theme.Text}" Stretch="Uniform" Width="14" Height="14"/>
                                </Button>
                                <Button Grid.Column="3" Style="{StaticResource IconButtonStyle}" Width="26" Height="26"
                                        VerticalAlignment="Top"
                                        ToolTip="Close chat (no active chat)" Click="OnCloseChat">
                                    <TextBlock Text="✕" FontSize="12" Foreground="{DynamicResource Theme.Text}"/>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                    <toolkit:ContextIndicator x:Name="ChatContextIndicator" Grid.Row="1" Margin="0,6,0,0"
                                              Model="{Binding}"/>
                    <toolkit:ChatMessagesControl x:Name="ChatMessages" Grid.Row="2"/>
                    <toolkit:MessageQueueControl x:Name="MessageQueue" Grid.Row="3" Margin="0,4,0,0"/>
                    <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,4,0,4">
                        <TextBlock x:Name="AgentStatusText" VerticalAlignment="Center"
                                   Margin="0,3,8,0" TextWrapping="Wrap"
                                   Text="{Binding StatusText}"
                                   Visibility="{Binding Phase, Converter={StaticResource PhaseStreamingVisibility}}">
                            <TextBlock.Foreground>
                                <LinearGradientBrush MappingMode="RelativeToBoundingBox" SpreadMethod="Repeat"
                                                     StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="#6E6E6E" Offset="0"/>
                                    <GradientStop Color="#E9E9E9" Offset="0.5"/>
                                    <GradientStop Color="#6E6E6E" Offset="1"/>
                                </LinearGradientBrush>
                            </TextBlock.Foreground>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <Trigger Property="Visibility" Value="Visible">
                                            <Trigger.EnterActions>
                                                <BeginStoryboard Name="StatusShimmer">
                                                    <Storyboard RepeatBehavior="Forever">
                                                        <PointAnimation Storyboard.TargetProperty="Foreground.(LinearGradientBrush.StartPoint)"
                                                                        From="0,0" To="1,0" Duration="0:0:1.2"/>
                                                        <PointAnimation Storyboard.TargetProperty="Foreground.(LinearGradientBrush.EndPoint)"
                                                                        From="1,0" To="2,0" Duration="0:0:1.2"/>
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <StopStoryboard BeginStoryboardName="StatusShimmer"/>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <TextBlock x:Name="AgentErrorText" VerticalAlignment="Center"
                                   Margin="0,0,8,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Theme.ErrorText}"
                                   Text="{Binding StatusErrorText}"
                                   Visibility="{Binding Phase, Converter={StaticResource PhaseErrorVisibility}}"/>
                    </StackPanel>
                    <Button x:Name="CancelButton" Grid.Row="5" Content="Cancel" FontSize="14"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Background="Transparent" Foreground="{DynamicResource Theme.Text}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                            Padding="10,2"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Margin="0,0,0,0" Click="OnCancelSend"
                            Visibility="{Binding Phase, Converter={StaticResource PhaseStreamingVisibility}}"/>
                    <Button x:Name="ResumeButton" Grid.Row="5" Content="Resume task" FontSize="14"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Background="Transparent" Foreground="{DynamicResource Theme.Text}" BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                            Padding="10,2"
                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                            Margin="0,0,0,0" Click="OnResumeTask"
                            Visibility="{Binding CanResume, Converter={StaticResource BoolToVis}}"/>
                    <ItemsControl Grid.Row="6" x:Name="AttachmentsList" Margin="0,0,0,4" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource Theme.Control}" BorderBrush="{DynamicResource Theme.Border}"
                                        BorderThickness="1" CornerRadius="2" Padding="6,2" Margin="0,0,6,4">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding DisplayText}" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource Theme.Text}" FontSize="13"/>
                                        <Button Content="✕" Width="16" Height="16" Margin="6,0,0,0"
                                                Style="{StaticResource IconButtonStyle}" FontSize="10"
                                                Tag="{Binding}" Click="OnRemoveAttachment" ToolTip="Remove attachment"/>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>

                <GridSplitter x:Name="ChatSplitter" Grid.Row="3" Height="5" HorizontalAlignment="Stretch"
                              VerticalAlignment="Center" ResizeDirection="Rows"
                              ResizeBehavior="PreviousAndNext"/>

                <Grid x:Name="ChatInputPanel" Grid.Row="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <Border x:Name="ChatInputBorder"
                            Background="{DynamicResource Theme.Control}"
                            BorderThickness="1" CornerRadius="2"
                            Margin="0,5,0,0" Padding="6,4">
                        <Border.Style>
                            <!-- The border shows the mode and wraps both the input box and the action
                                 buttons. It follows Chat.Mode directly: one source of truth, no
                                 code-behind brush assignment. BorderBrush lives only in this style
                                 (not as a local attribute) so the DataTriggers below can override it. -->
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.ModePlan}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Mode}" Value="{x:Static corem:AgentMode.Act}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.ModeAct}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding Mode}" Value="{x:Static corem:AgentMode.Help}">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.ModeHelp}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox Grid.Column="0" x:Name="InputBox"
                                     AcceptsReturn="True" TextWrapping="Wrap" FontSize="14"
                                     Background="Transparent" BorderThickness="0"
                                     VerticalScrollBarVisibility="Auto"
                                     PreviewKeyDown="OnInputKeyDown"/>
                            <toolkit:TopOverflowWrapPanel Grid.Column="1" VerticalAlignment="Bottom" VerticalSpacing="4" ColumnSpacing="8" MaxItemsPerColumn="2">
                                <Button x:Name="ClearInputButton" Width="26" Height="26"
                                        Click="OnClearInput"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Clear message">
                                    <Path Data="{Binding Source={x:Static mi:MaterialIconKind.Broom}, Converter={StaticResource MaterialIconToGeometry}}"
                                          Fill="{DynamicResource Theme.Text}" Stretch="Uniform" Width="14" Height="14"/>
                                </Button>
                                <Button x:Name="AttachButton" Width="26" Height="26"
                                        Click="OnAttach"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Attach image or file">
                                    <Path Data="M16.5,6v11.5a4,4 0 0 1 -8,0V5a2.5,2.5 0 0 1 5,0v10.5a1,1 0 0 1 -2,0V6H10v9.5a2.5,2.5 0 0 0 5,0V5a4,4 0 0 0 -8,0v12.5a5.5,5.5 0 0 0 11,0V6h-1.5z"
                                          Fill="{DynamicResource Theme.Text}" Stretch="Uniform"
                                          Width="14" Height="14"/>
                                </Button>
                                <Button x:Name="MicButton" Width="26" Height="26"
                                        Click="OnMicClick"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Start voice input">
                                    <Path x:Name="MicIcon" Fill="{DynamicResource Theme.Text}" Stretch="Uniform" Width="14" Height="14">
                                        <Path.Data>
                                            <GeometryGroup FillRule="Nonzero">
                                                <RectangleGeometry Rect="9,2,6,12" RadiusX="3" RadiusY="3"/>
                                                <PathGeometry Figures="M19,11 C19,14.53 16.39,17.44 13,17.93 L13,21 L11,21 L11,17.93 C7.61,17.44 5,14.53 5,11 L7,11 C7,13.76 9.24,16 12,16 C14.76,16 17,13.76 17,11 L19,11 Z"/>
                                            </GeometryGroup>
                                        </Path.Data>
                                    </Path>
                                </Button>
                                <Button x:Name="SendButton" Width="26" Height="26"
                                        Click="OnSend"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="Send (Enter)">
                                    <Path Data="M 2,21 L 23,12 L 2,3 L 2,10 L 17,12 L 2,14 L 2,21 Z"
                                          Fill="{DynamicResource Theme.Text}" Stretch="Uniform"
                                          Width="14" Height="14"/>
                                </Button>
                            </toolkit:TopOverflowWrapPanel>
                        </Grid>
                    </Border>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,0">
                        <TextBlock Text="Mode:" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="{DynamicResource Theme.TextMuted}"/>
                        <!-- Two-way: the toggle shows Chat.Mode and writes it back; the handler only
                             records the switch and persists the session. -->
                        <toolkit:SegmentedToggle x:Name="ModeToggle" Height="24" VerticalAlignment="Center"
                                                  SelectedValue="{Binding Mode, Converter={StaticResource ModeToToggle}, Mode=TwoWay}"
                                                  ValueChanged="OnModeChanged">
                            <toolkit:SegmentedToggle.Items>
                                <toolkit:SegmentedToggleItem Label="Plan" Value="Plan" Accent="{DynamicResource Theme.ModePlan}"/>
                                <toolkit:SegmentedToggleItem Label="Act" Value="Act" Accent="{DynamicResource Theme.ModeAct}"/>
                                <toolkit:SegmentedToggleItem Label="Help" Value="Help" Accent="{DynamicResource Theme.ModeHelp}"/>
                            </toolkit:SegmentedToggle.Items>
                        </toolkit:SegmentedToggle>
                        <Button x:Name="CompactNowButton" Click="OnCompactNow" Width="24" Height="24"
                                Margin="10,0,0,0" VerticalAlignment="Center"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Summarize the conversation to free context space">
                            <Button.IsEnabled>
                                <MultiBinding Converter="{StaticResource AllTrue}">
                                    <Binding Path="Chat.HasActiveConversation"/>
                                    <Binding Path="Chat.Phase" Converter="{StaticResource PhaseNotStreaming}"/>
                                </MultiBinding>
                            </Button.IsEnabled>
                            <Grid>
                                <Path Data="{Binding Source={x:Static mi:MaterialIconKind.Compress}, Converter={StaticResource MaterialIconToGeometry}}"
                                      Fill="{DynamicResource Theme.Text}" Stretch="Uniform" Width="14" Height="14"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                <Ellipse x:Name="CompactIndicator" Width="6" Height="6"
                                          Fill="Red" HorizontalAlignment="Right" VerticalAlignment="Top"
                                          Margin="0,2,2,0" Visibility="Collapsed"/>
                            </Grid>
                        </Button>
                        <Button x:Name="UpdateMemoryButton" Click="OnUpdateMemory" Width="24" Height="24"
                                Margin="6,0,0,0" VerticalAlignment="Center"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Ask the agent to update the project memory bank">
                            <Path Data="{Binding Source={x:Static mi:MaterialIconKind.Database}, Converter={StaticResource MaterialIconToGeometry}}"
                                  Fill="{DynamicResource Theme.Text}" Stretch="Uniform" Width="14" Height="14"/>
                        </Button>
                        <Button x:Name="PermissionsButton" Click="OnPermissionsClick" Width="24" Height="24"
                                Margin="6,0,0,0" VerticalAlignment="Center"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Configure agent permissions (read files, edit files, execute commands, web fetch, MCP)">
                            <Path Data="{Binding Source={x:Static mi:MaterialIconKind.ShieldKey}, Converter={StaticResource MaterialIconToGeometry}}"
                                  Fill="{DynamicResource Theme.Text}" Stretch="Uniform" Width="14" Height="14"/>
                        </Button>
                        <Button x:Name="DocsButton" Click="OnDocsClick" Width="24" Height="24"
                                Margin="6,0,0,0" VerticalAlignment="Center"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="Open the documentation">
                            <Path Data="{Binding Source={x:Static mi:MaterialIconKind.BookOpenOutline}, Converter={StaticResource MaterialIconToGeometry}}"
                                  Fill="{DynamicResource Theme.Text}" Stretch="Uniform" Width="14" Height="14"/>
                        </Button>
                        <Button x:Name="DoItButton" Content="Do it!!!" Height="24"
                                Click="OnDoItClick"
                                Padding="8,2" Margin="6,0,0,0" VerticalAlignment="Center"
                                IsEnabled="{Binding Phase, Converter={StaticResource PhaseNotStreaming}}"
                                ToolTip="Send the input text plus 'Do it!!!' to the agent and switch it to Act mode"/>
                    </StackPanel>

                    <Border x:Name="PermissionsOverlay" Grid.Row="0" Grid.RowSpan="2"
                            Background="{DynamicResource Theme.Panel}"
                            BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                            CornerRadius="2" Padding="12,10" Visibility="Collapsed">
                        <StackPanel TextElement.FontSize="14">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Agent permissions" FontWeight="Bold"
                                           Foreground="{DynamicResource Theme.Text}" VerticalAlignment="Center"/>
                                <Button Grid.Column="1" Style="{StaticResource IconButtonStyle}" Width="20" Height="20"
                                        ToolTip="Close" Click="OnPermissionsClose">
                                    <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource Theme.Text}"/>
                                </Button>
                            </Grid>
                            <CheckBox x:Name="AllowReadFilesCheckBox" Content="Read files"
                                      Checked="OnPermissionChanged" Unchecked="OnPermissionChanged" Margin="0,8,0,0"
                                      Foreground="{DynamicResource Theme.Text}"/>
                            <CheckBox x:Name="AllowEditFilesCheckBox" Content="Edit files"
                                      Checked="OnPermissionChanged" Unchecked="OnPermissionChanged" Margin="0,4,0,0"
                                      Foreground="{DynamicResource Theme.Text}"/>
                            <CheckBox x:Name="AllowExecuteCommandCheckBox" Content="Execute commands (PowerShell)"
                                      Checked="OnPermissionChanged" Unchecked="OnPermissionChanged" Margin="0,4,0,0"
                                      Foreground="{DynamicResource Theme.Text}"/>
                            <CheckBox x:Name="AllowWebFetchCheckBox" Content="Web fetch"
                                      Checked="OnPermissionChanged" Unchecked="OnPermissionChanged" Margin="0,4,0,0"
                                      Foreground="{DynamicResource Theme.Text}"/>
                            <CheckBox x:Name="AllowMcpCheckBox" Content="MCP"
                                      Checked="OnPermissionChanged" Unchecked="OnPermissionChanged" Margin="0,4,0,0"
                                      Foreground="{DynamicResource Theme.Text}"/>
                            <CheckBox x:Name="AskBeforeEachToolCheckBox" Content="Ask before each tool"
                                      Checked="OnPermissionChanged" Unchecked="OnPermissionChanged" Margin="0,4,0,0"
                                      Foreground="{DynamicResource Theme.Text}"
                                      ToolTip="Ask for approval before the agent executes each tool call"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="DocsOverlay" Grid.Row="0" Grid.RowSpan="6"
                        Background="{DynamicResource Theme.Window}"
                        BorderBrush="{DynamicResource Theme.Border}" BorderThickness="1"
                        CornerRadius="2" Padding="12,10" Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="DocsTitleText" Grid.Column="0" Text="Documentation"
                                       FontWeight="Bold" FontSize="16"
                                       Foreground="{DynamicResource Theme.Text}" VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"/>
                            <Button Grid.Column="1" Content="Home" Click="OnDocsHome" Padding="8,2"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Back to the documentation index"/>
                            <Button Grid.Column="2" Style="{StaticResource IconButtonStyle}" Width="20" Height="20"
                                    Margin="8,0,0,0" VerticalAlignment="Center"
                                    ToolTip="Close" Click="OnDocsClose">
                                <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource Theme.Text}"/>
                            </Button>
                        </Grid>
                        <ScrollViewer Grid.Row="1" x:Name="DocsScroll"
                                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                            <ContentControl x:Name="DocsContent" Margin="4"
                                            HorizontalContentAlignment="Stretch" HorizontalAlignment="Stretch"/>
                        </ScrollViewer>
                    </Grid>
                </Border>

                <Grid x:Name="HistoryViewPanel" Grid.Row="0" Grid.RowSpan="5"
                      Background="{DynamicResource Theme.Window}" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Button HorizontalAlignment="Left" Content="New chat" Click="OnNewChat" Margin="0,5,0,0"/>
                        <Button HorizontalAlignment="Right" Content="Clear history" Click="OnClearHistory" Margin="0,5,0,0"/>
                    </Grid>

                    <TextBlock Grid.Row="1" Text="Chat history" FontWeight="Bold" HorizontalAlignment="Center"
                               Margin="0,16,0,8" Foreground="{DynamicResource Theme.Text}"/>

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  HorizontalAlignment="Center" MaxWidth="420">
                        <ItemsControl x:Name="HistoryList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,6">
                                        <Button HorizontalContentAlignment="Stretch" Click="OnHistoryCardClick" Padding="10,8,32,8" MinWidth="150">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <!-- Green dot = the single activity indicator of the chat: a display projection of
                                                         ChatModel.ActiveChatConversation (ChatConversation.IsActive). No other element or
                                                         field in the view tracks which chat is active. -->
                                                    <Ellipse Grid.Column="0" Width="8" Height="8" Fill="#7AC88F" Margin="0,0,7,0" VerticalAlignment="Center"
                                                             ToolTip="Active chat"
                                                             Visibility="{Binding IsActive, Converter={StaticResource BoolToVis}}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CardTitle}" TextWrapping="Wrap"
                                                               Foreground="{DynamicResource Theme.Text}" FontWeight="SemiBold"/>
                                                </Grid>
                                                <TextBlock Text="{Binding DisplayDate}" Margin="0,4,0,0"
                                                           Foreground="{DynamicResource Theme.TextSecondary}"/>
                                            </StackPanel>
                                        </Button>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                                                Style="{StaticResource IconButtonStyle}" Width="22" Height="22"
                                                ToolTip="Delete chat" Click="OnDeleteHistoryCard">
                                            <TextBlock Text="✕" FontSize="11" Foreground="{DynamicResource Theme.Text}"/>
                                        </Button>
                                        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,28,6,0"
                                                Style="{StaticResource IconButtonStyle}" Width="22" Height="22"
                                                ToolTip="Mark as important" Click="OnToggleImportant">
                                            <TextBlock Text="!" FontSize="13" FontWeight="Bold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Theme.TextSecondary}"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsImportant}" Value="True">
                                                                <Setter Property="Foreground" Value="#FF8C00"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>

            </Grid></UserControl>