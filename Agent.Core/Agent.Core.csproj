<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-free agent core shared across the agent hosts.
    Must stay netstandard2.0 and reference no WPF/VSIX/DTE assemblies.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>Agent.Core</RootNamespace>
    <AssemblyName>Agent.Core</AssemblyName>
    <IsPackable>false</IsPackable>
    <Description>UI-free agent core: tool framework, checkpoints, context, contracts, prompt library, provider, markdown, memory bank.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.4.2" />
    <PackageReference Include="DiffPlex" Version="1.9.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.0.2" />
    <PackageReference Include="NPOI" Version="2.7.6" />
    <PackageReference Include="System.Reflection.MetadataLoadContext" Version="8.0.0" />
  </ItemGroup>

  <!--
    Release builds of Agent.Core auto-pack the combined toolkit into the local feed
    (feed\). The next version is derived from the highest version already in the feed
    and bumped at the trailing component: 1.7.2 -> 1.7.2.1, 1.4.5.6 -> 1.4.5.7.
    Set AgentSkipReleasePack=true to suppress this (used by pack.ps1, CI and the
    PackTool itself to avoid recursion).
  -->
  <Target Name="PackToolkitToFeed" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release' And '$(AgentSkipReleasePack)' != 'true'">
    <Exec Command="dotnet run --project &quot;$(MSBuildProjectDirectory)\..\PackTool\PackTool.csproj&quot; -c Release -- &quot;$(MSBuildProjectDirectory)\..&quot;" />
  </Target>

</Project>
