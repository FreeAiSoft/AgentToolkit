<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:conv="clr-namespace:Agent.Toolkit.Wpf.Converters"
                    xmlns:chat="clr-namespace:Agent.Toolkit.Wpf.Controls.Chat"
                    xmlns:controls="clr-namespace:Agent.Toolkit.Wpf.Controls">

    <!-- Dark scrollbar styling: shared by every control that merges this dictionary
         (ChatMessagesControl, MessageQueueControl and all message controls). -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/Agent.Toolkit.Wpf;component/Styles/DarkScrollBars.xaml"/>
    </ResourceDictionary.MergedDictionaries>

    <!-- Theme brushes come from the Dark/Light palette registered by AgentThemeManager. -->

    <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    <conv:MarkdownToElementConverter x:Key="MarkdownToElement"/>
    <conv:OptionEqualsAnswerConverter x:Key="OptionEqualsAnswerConverter"/>

    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Same hover/press behavior as IconButtonStyle, but for the ToggleButton used by the
         per-card "more actions" menu in the history view. -->
    <Style x:Key="IconToggleButtonStyle" TargetType="ToggleButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.7"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.3"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Stealth option buttons for the question control: theme text, transparent
         background and a barely visible hover so the options don't pop sharply. -->
    <Style x:Key="Question.OptionButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text}"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.QuestionOptionBorder}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="2"
                            Padding="{TemplateBinding Padding}">
                        <TextBlock Text="{TemplateBinding Content}"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.QuestionOptionHover}"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Theme.QuestionOptionPressed}"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Shared chrome for every message card: accent border + header (chevron/timestamp/copy)
         + a content area for the per-kind body. -->
    <Style TargetType="{x:Type chat:ChatMessageCard}">
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type chat:ChatMessageCard}">
                    <Border CornerRadius="2" Padding="8,6" Margin="0,4,0,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="Transparent"/>
                                <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding KindName}" Value="User">
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Background" Value="{DynamicResource Theme.ChatUserBackground}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="ToolCall">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border}"/>
                                        <Setter Property="Background" Value="{DynamicResource Theme.Control}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="ToolBlocked">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardToolBlockedBorder}"/>
                                        <Setter Property="Background" Value="{DynamicResource Theme.CardToolBlockedBackground}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="Error">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardErrorBorder}"/>
                                        <Setter Property="Background" Value="{DynamicResource Theme.CardErrorBackground}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="Compaction">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardCompactionBorder}"/>
                                        <Setter Property="Background" Value="{DynamicResource Theme.CardCompactionBackground}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="ModeSwitch">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardModeSwitchBorder}"/>
                                        <Setter Property="Background" Value="{DynamicResource Theme.CardModeSwitchBackground}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="Question">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardModeSwitchBorder}"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="Subagent">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.CardSubagentBorder}"/>
                                        <Setter Property="Background" Value="{DynamicResource Theme.CardSubagentBackground}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerPlan">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.ChatLastPlanBorder}"/>
                                        <Setter Property="Background" Value="{DynamicResource Theme.ChatLastPlanBackground}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerAct">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Theme.ChatLastActBorder}"/>
                                        <Setter Property="Background" Value="{DynamicResource Theme.ChatLastActBackground}"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid Grid.Row="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="ExecutingDot" Grid.Column="0" Width="6" Height="6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="-7,0,0,0" RenderTransformOrigin="0.5,0.5" Opacity="0" Fill="{DynamicResource Theme.ActiveDot}" Visibility="Collapsed" ToolTip="Command running"/>
                                <Button x:Name="ToggleButton" Grid.Column="0" Width="18" Height="18"
                                        VerticalAlignment="Center" ToolTip="Expand/collapse message">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource IconButtonStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerPlan">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerAct">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KindName}" Value="Question">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KindName}" Value="ModeSwitch">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <Viewbox Width="12" Height="12">
                                        <Polyline x:Name="Chevron" Points="6,9 12,15 18,9"
                                                  Stroke="{DynamicResource Theme.Text}" StrokeThickness="2"
                                                  StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                  Fill="Transparent"/>
                                    </Viewbox>
                                </Button>
                                <TextBlock Grid.Column="1" Text="{Binding MessageTitle}" FontWeight="SemiBold"
                                           Foreground="{DynamicResource Theme.Text}" TextTrimming="CharacterEllipsis"
                                           VerticalAlignment="Center" Margin="8,0,8,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding KindName}" Value="ToolCall">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KindName}" Value="ToolBlocked">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KindName}" Value="ModeSwitch">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KindName}" Value="User">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KindName}" Value="SystemNotice">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KindName}" Value="AgentText">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KindName}" Value="Error">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding KindName}" Value="Subagent">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                                <!-- The header title duplicates the body's first line for User/SystemNotice/Error;
                                                     hide it while the card is expanded so the text is not shown twice. -->
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding KindName}" Value="User"/>
                                                        <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding KindName}" Value="SystemNotice"/>
                                                        <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </MultiDataTrigger>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding KindName}" Value="Error"/>
                                                        <Condition Binding="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" Value="True"/>
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock Grid.Column="2" Text="{Binding TimestampLocal, StringFormat=HH.mm.ss}"
                                           Foreground="{DynamicResource Theme.TextSecondary}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"
                                           ToolTip="{Binding TimestampToolTip}"
                                           Visibility="{Binding ShowTimestamp, RelativeSource={RelativeSource AncestorType=controls:ChatMessagesControl}, Converter={StaticResource BoolToVis}}"/>
                                <Button x:Name="CopyButton" Grid.Column="3" Style="{StaticResource IconButtonStyle}" Width="16" Height="16"
                                        VerticalAlignment="Center" ToolTip="Copy message">
                                    <Path Data="M16 1H4c-1.1 0-2 .9-2 2v14h2V3h12V1zm3 4H8c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h11c1.1 0 2-.9 2-2V7c0-1.1-.9-2-2-2zm0 16H8V7h11v14z"
                                          Fill="{DynamicResource Theme.Text}" Stretch="Uniform" Width="12" Height="12"/>
                                </Button>
                            </Grid>
                            <ContentPresenter x:Name="Body" Grid.Row="1" Margin="0,5,0,0"
                                              Content="{TemplateBinding Content}">
                                <ContentPresenter.Style>
                                    <Style TargetType="ContentPresenter">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding KindName}" Value="ModeSwitch">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </ContentPresenter.Style>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="False">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed"/>
                            <Setter TargetName="Chevron" Property="Points" Value="9,18 15,12 9,6"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <!-- Messages whose chevron is hidden have no way to expand, so keep them expanded. -->
            <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerPlan">
                <Setter Property="IsExpanded" Value="True"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding KindName}" Value="ResultAnswerAct">
                <Setter Property="IsExpanded" Value="True"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding KindName}" Value="Question">
                <Setter Property="IsExpanded" Value="True"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding KindName}" Value="Approval">
                <Setter Property="IsExpanded" Value="True"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding KindName}" Value="ModeSwitch">
                <Setter Property="IsExpanded" Value="True"/>
            </DataTrigger>
            <DataTrigger Binding="{Binding KindName}" Value="Checkpoint">
                <Setter Property="IsExpanded" Value="True"/>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Selects the per-kind message control for each ChatMessage. -->
    <chat:ChatMessageTemplateSelector x:Key="ChatMessageTemplateSelector"/>
</ResourceDictionary>
