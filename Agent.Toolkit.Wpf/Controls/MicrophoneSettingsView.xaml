<UserControl x:Class="Agent.Toolkit.Wpf.Controls.MicrophoneSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded"
             Unloaded="OnUnloaded">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Agent.Toolkit.Wpf;component/Styles/AgentTheme.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="8"
              VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                       Grid.Column="0"
                       Text="Input device"
                       VerticalAlignment="Center"
                       Margin="0,0,8,4" />
            <ComboBox Grid.Row="0"
                      Grid.Column="1"
                      x:Name="DevicesCombo"
                      DisplayMemberPath="DisplayName"
                      SelectionChanged="OnDeviceSelectionChanged"
                      VerticalAlignment="Center"
                      Margin="0,0,8,4" />
            <Button Grid.Row="0"
                    Grid.Column="2"
                    Content="Refresh devices"
                    Click="OnRefreshDevices"
                    VerticalAlignment="Center"
                    Margin="0,0,0,4" />

            <TextBlock Grid.Row="1"
                       Grid.Column="0"
                       Text="Input level"
                       VerticalAlignment="Center"
                       Margin="0,0,8,4" />
            <ProgressBar Grid.Row="1"
                         Grid.Column="1"
                         Grid.ColumnSpan="2"
                         x:Name="LevelBar"
                         Minimum="0"
                         Maximum="100"
                         Height="18"
                         VerticalAlignment="Center" />
        </Grid>
    </ScrollViewer>
</UserControl>
