<UserControl x:Class="Agent.Toolkit.Wpf.Controls.Chat.ResultAnswerPlanControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:chat="clr-namespace:Agent.Toolkit.Wpf.Controls.Chat">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Agent.Toolkit.Wpf;component/Styles/ChatResources.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <chat:ChatMessageCard>
        <StackPanel>
            <Expander Header="{Binding ReasoningHeader, Mode=OneWay}" IsExpanded="{Binding IsThinking, Mode=OneWay}"
                      Foreground="{DynamicResource Theme.Text}"
                      Visibility="{Binding ShowReasoning, Converter={StaticResource BoolToVis}}">
                <TextBox Text="{Binding ReasoningDisplayText, Mode=OneWay}"
                         Foreground="{DynamicResource Theme.TextMuted}" FontStyle="Italic"
                         IsReadOnly="True" Background="Transparent" BorderThickness="0" Padding="0">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="TextWrapping" Value="Wrap"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsThinking}" Value="True">
                                    <Setter Property="TextWrapping" Value="NoWrap"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Expander>
            <TextBlock Text="{Binding Label, Mode=OneWay}" FontWeight="SemiBold"
                       Foreground="{DynamicResource Theme.Text}" TextWrapping="Wrap" Margin="0,0,0,4"/>
            <ContentControl Content="{Binding Text, Mode=OneWay, Converter={StaticResource MarkdownToElement}}"/>
        </StackPanel>
    </chat:ChatMessageCard>
</UserControl>
