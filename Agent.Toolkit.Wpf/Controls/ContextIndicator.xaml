<UserControl x:Class="Agent.Toolkit.Wpf.Controls.ContextIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid x:Name="FillTrack" Height="4">
            <Border Background="{DynamicResource Theme.ContextTrackBackground}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="CacheHitColumn" Width="0*"/>
                    <ColumnDefinition x:Name="MissColumn" Width="0*"/>
                    <ColumnDefinition x:Name="RemainderColumn" Width="1*"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="CacheHitSegment" Grid.Column="0" Background="{DynamicResource Theme.ContextCacheHit}"/>
                <Border x:Name="MissSegment" Grid.Column="1" Background="{DynamicResource Theme.ContextMiss}"/>
            </Grid>
        </Grid>
        <TextBlock x:Name="FillText" Margin="0,4,0,0" Foreground="{DynamicResource Theme.TextMuted}"
                   Text="Context window: —"/>
        <TextBlock x:Name="CacheText" Margin="0,2,0,0" Foreground="{DynamicResource Theme.TextSecondary}"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
        <TextBlock x:Name="StatsText" Margin="0,2,0,0" Foreground="{DynamicResource Theme.TextSecondary}"
                   TextWrapping="Wrap" Visibility="Collapsed"/>
    </StackPanel>
</UserControl>
