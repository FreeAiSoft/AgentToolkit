<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Light palette. Same theme-neutral keys as Theme.Dark.xaml, light values.
    -->

    <!-- General chrome -->
    <SolidColorBrush x:Key="Theme.Window" Color="#F5F5F5"/>
    <SolidColorBrush x:Key="Theme.Panel" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Theme.Control" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="Theme.ControlHover" Color="#E8E8E8"/>
    <SolidColorBrush x:Key="Theme.ControlPressed" Color="#C8D9EC"/>
    <SolidColorBrush x:Key="Theme.Accent" Color="#1A73E8"/>
    <SolidColorBrush x:Key="Theme.Highlight" Color="#1A73E8"/>
    <SolidColorBrush x:Key="Theme.Border" Color="#C8C8C8"/>
    <SolidColorBrush x:Key="Theme.Text" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Theme.ErrorText" Color="#B3261E"/>
    <SolidColorBrush x:Key="Theme.TextSecondary" Color="#6E6E6E"/>
    <SolidColorBrush x:Key="Theme.TextMuted" Color="#767676"/>

    <!-- Code blocks -->
    <SolidColorBrush x:Key="Theme.CodeBackground" Color="#FFFFFF"/>

    <!-- Scrollbars -->
    <SolidColorBrush x:Key="Theme.ScrollThumb" Color="#A6A6A6"/>
    <SolidColorBrush x:Key="Theme.ScrollThumbHover" Color="#8C8C8C"/>
    <SolidColorBrush x:Key="Theme.ScrollThumbDrag" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="Theme.ScrollBackground" Color="#EEEEEE"/>

    <!-- Chat message accents -->
    <SolidColorBrush x:Key="Theme.ChatUserBorder" Color="#CC1A73E8"/>
    <SolidColorBrush x:Key="Theme.ChatUserBackground" Color="#1A1A73E8"/>
    <SolidColorBrush x:Key="Theme.ChatLastActBackground" Color="#0D2E7D32"/>
    <SolidColorBrush x:Key="Theme.ChatLastActBorder" Color="#2E7D32"/>
    <SolidColorBrush x:Key="Theme.ChatLastPlanBackground" Color="#14EF6C00"/>
    <SolidColorBrush x:Key="Theme.ChatLastPlanBorder" Color="#EF6C00"/>

    <!-- Question / approval -->
    <SolidColorBrush x:Key="Theme.QuestionOptionBorder" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Theme.QuestionOptionHover" Color="#1A1E1E1E"/>
    <SolidColorBrush x:Key="Theme.QuestionOptionPressed" Color="#261E1E1E"/>
    <SolidColorBrush x:Key="Theme.QuestionAnswerBorder" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="Theme.QuestionAnswerBackground" Color="#226B6B6B"/>
    <SolidColorBrush x:Key="Theme.ApprovalApprove" Color="#2E7D32"/>
    <SolidColorBrush x:Key="Theme.ApprovalReject" Color="#C62828"/>
    <SolidColorBrush x:Key="Theme.ApprovalDecided" Color="#6B6B6B"/>

    <!-- Agent mode accents -->
    <SolidColorBrush x:Key="Theme.ModePlan" Color="#1565C0"/>
    <SolidColorBrush x:Key="Theme.ModeAct" Color="#2E7D32"/>
    <SolidColorBrush x:Key="Theme.ModeHelp" Color="#C62828"/>

    <!-- Message card semantic accents -->
    <SolidColorBrush x:Key="Theme.CardToolBlockedBorder" Color="#B0563C"/>
    <SolidColorBrush x:Key="Theme.CardToolBlockedBackground" Color="#FBEAE7"/>
    <SolidColorBrush x:Key="Theme.CardErrorBorder" Color="#B0563C"/>
    <SolidColorBrush x:Key="Theme.CardErrorBackground" Color="#FDE7E9"/>
    <SolidColorBrush x:Key="Theme.CardCompactionBorder" Color="#6B6B2E"/>
    <SolidColorBrush x:Key="Theme.CardCompactionBackground" Color="#FBF3D0"/>
    <SolidColorBrush x:Key="Theme.CardModeSwitchBorder" Color="#4A6B9A"/>
    <SolidColorBrush x:Key="Theme.CardModeSwitchBackground" Color="#E3EDFB"/>
    <SolidColorBrush x:Key="Theme.CardSubagentBorder" Color="#4A6B9A"/>
    <SolidColorBrush x:Key="Theme.CardSubagentBackground" Color="#E3EDFB"/>

    <!-- Context indicator -->
    <SolidColorBrush x:Key="Theme.ContextTrackBackground" Color="#1A000000"/>
    <SolidColorBrush x:Key="Theme.ContextCacheHit" Color="#66BB6A"/>
    <SolidColorBrush x:Key="Theme.ContextMiss" Color="#9E9E9E"/>
    <SolidColorBrush x:Key="Theme.ContextNormal" Color="#1A73E8"/>
    <SolidColorBrush x:Key="Theme.ContextWarning" Color="#EF6C00"/>
    <SolidColorBrush x:Key="Theme.ContextOverflow" Color="#C62828"/>

    <!-- ChatControl accents -->
    <SolidColorBrush x:Key="Theme.ActiveDot" Color="#2E7D32"/>
    <SolidColorBrush x:Key="Theme.ImportantMark" Color="#EF6C00"/>
    <SolidColorBrush x:Key="Theme.CheckpointHash" Color="#2E7D32"/>
    <SolidColorBrush x:Key="Theme.CheckpointState" Color="#1A73E8"/>

    <!-- Markdown & syntax highlighting -->
    <SolidColorBrush x:Key="Theme.CodeForeground" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="Theme.Link" Color="#1A73E8"/>
    <SolidColorBrush x:Key="Theme.TableEvenBackground" Color="#F0F0F0"/>
    <SolidColorBrush x:Key="Theme.SyntaxKeyword" Color="#0000FF"/>
    <SolidColorBrush x:Key="Theme.SyntaxString" Color="#A31515"/>
    <SolidColorBrush x:Key="Theme.SyntaxComment" Color="#008000"/>
    <SolidColorBrush x:Key="Theme.SyntaxNumber" Color="#098658"/>

    <!-- Status shimmer gradient stops -->
    <Color x:Key="Theme.ShimmerLow">#6E6E6E</Color>
    <Color x:Key="Theme.ShimmerHigh">#1E1E1E</Color>

    <!-- Queue steer shimmer gradient stops (amber) -->
    <Color x:Key="Theme.SteerShimmerLow">#8A5000</Color>
    <Color x:Key="Theme.SteerShimmerHigh">#FFB300</Color>
</ResourceDictionary>
