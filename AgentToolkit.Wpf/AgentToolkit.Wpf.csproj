<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Package wrapper for the shared WPF assembly. Like AgentToolkit, the source project is
    intentionally NOT a ProjectReference here so it does not become a package dependency; it is
    built separately before packing (see pack.ps1 / build.yml). Consumers install AgentToolkit
    (Agent.Core/Models/Mvvm) alongside this package.
  -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <RootNamespace>AgentToolkit.Wpf</RootNamespace>
    <AssemblyName>AgentToolkit.Wpf</AssemblyName>
    <PackageId>AgentToolkit.Wpf</PackageId>
    <Description>AgentToolkit.Wpf: shared WPF controls for the agent hosts.</Description>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <!-- Runtime dependencies of the bundled Agent.Toolkit.Wpf.dll. Markdig and Newtonsoft.Json
         also arrive via AgentToolkit, but Material.Icons and WebView2 are new to this package. -->
    <PackageReference Include="Markdig" Version="1.4.2" />
    <PackageReference Include="Material.Icons" Version="3.0.2" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
  </ItemGroup>

  <!-- Bundle the built WPF DLL into lib/net472. -->
  <ItemGroup>
    <None Include="..\Agent.Toolkit.Wpf\bin\$(Configuration)\net472\Agent.Toolkit.Wpf.dll" Pack="true" PackagePath="lib/net472/" />
  </ItemGroup>

</Project>
