<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console tool invoked by the Agent.Core Release post-build event. It derives the
    next package version from the local feed and repacks the combined toolkit.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>PackTool</AssemblyName>
    <RootNamespace>PackTool</RootNamespace>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

</Project>
