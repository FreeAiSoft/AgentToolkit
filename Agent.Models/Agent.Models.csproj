<Project Sdk="Microsoft.NET.Sdk">

  <!--
    UI-free shared product models (ChatModel, SettingsModel and the tool-toggle helpers).
    netstandard2.0 + no UI references, so the models are testable headless.
  -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <Nullable>annotations</Nullable>
    <RootNamespace>Agent.Models</RootNamespace>
    <AssemblyName>Agent.Models</AssemblyName>
    <PackageId>AgentToolkit.Models</PackageId>
    <Description>UI-free shared models (chat, settings).</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Agent.Mvvm\Agent.Mvvm.csproj" />
    <ProjectReference Include="..\Agent.Core\Agent.Core.csproj" />
  </ItemGroup>

</Project>
